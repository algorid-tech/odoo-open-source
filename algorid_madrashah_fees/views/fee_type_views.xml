<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fee Type Tree View -->
    <record id="view_fee_type_tree" model="ir.ui.view">
        <field name="name">algorid.fee.type.tree</field>
        <field name="model">algorid.fee.type</field>
        <field name="arch" type="xml">
            <list string="Fee Types" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fee_category"/>
                <field name="frequency"/>
                <field name="default_amount"/>
                <field name="is_recurring"/>
            </list>
        </field>
    </record>

    <!-- Fee Type Form View -->
    <record id="view_fee_type_form" model="ir.ui.view">
        <field name="name">algorid.fee.type.form</field>
        <field name="model">algorid.fee.type</field>
        <field name="arch" type="xml">
            <form string="Fee Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_bn"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fee_category"/>
                            <field name="frequency"/>
                            <field name="default_amount"/>
                            <field name="is_recurring"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fee Type Action -->
    <record id="action_fee_type" model="ir.actions.act_window">
        <field name="name">Fee Types</field>
        <field name="res_model">algorid.fee.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fee type
            </p>
        </field>
    </record>
</odoo>

