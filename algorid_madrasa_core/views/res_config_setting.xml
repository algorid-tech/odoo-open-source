<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_inherit_merge_so_line" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.merge.so.line</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="merge_sale_line_configuration" string="Merge Duplicate Lines"
                    help="Auto merge duplicate lines in sale order when creating or editing.">
                    <field name="is_merge_duplicate_so_line"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
