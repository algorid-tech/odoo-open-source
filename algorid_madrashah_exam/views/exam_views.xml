<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Exam Tree View -->
    <record id="view_exam_tree" model="ir.ui.view">
        <field name="name">algorid.exam.tree</field>
        <field name="model">algorid.exam</field>
        <field name="arch" type="xml">
            <list string="Exams" decoration-info="state == 'draft'" decoration-warning="state == 'ongoing'" decoration-success="state == 'published'">
                <field name="name"/>
                <field name="code"/>
                <field name="exam_type"/>
                <field name="academic_year_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="result_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Exam Form View -->
    <record id="view_exam_form" model="ir.ui.view">
        <field name="name">algorid.exam.form</field>
        <field name="model">algorid.exam</field>
        <field name="arch" type="xml">
            <form string="Exam">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Exam" type="object" invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Complete" type="object" invisible="state != 'ongoing'"/>
                    <button name="action_publish" string="Publish Results" type="object" class="btn-primary" invisible="state != 'completed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('published', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('cancelled', 'scheduled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,ongoing,completed,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_results" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="result_count" widget="statinfo" string="Results"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Exam Name"/>
                        </h1>
                        <field name="name_bn" placeholder="Exam Name (Bangla)"/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="exam_type"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="weightage"/>
                            <field name="pass_percentage"/>
                        </group>
                    </group>
                    <group>
                        <field name="class_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Exam Schedule" name="schedule">
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="class_id"/>
                                    <field name="subject_id"/>
                                    <field name="date"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room_no"/>
                                    <field name="invigilator_id"/>
                                    <field name="full_marks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Exam Search View -->
    <record id="view_exam_search" model="ir.ui.view">
        <field name="name">algorid.exam.search</field>
        <field name="model">algorid.exam</field>
        <field name="arch" type="xml">
            <search string="Search Exams">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="exam_type"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Ongoing" name="ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
            </search>
        </field>
    </record>

    <!-- Exam Action -->
    <record id="action_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">algorid.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exam
            </p>
            <p>
                Define exams with schedules and manage results.
            </p>
        </field>
    </record>
</odoo>

