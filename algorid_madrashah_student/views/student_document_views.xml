<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student Document Tree View -->
    <record id="view_student_document_tree" model="ir.ui.view">
        <field name="name">algorid.student.document.tree</field>
        <field name="model">algorid.student.document</field>
        <field name="arch" type="xml">
            <list string="Student Documents">
                <field name="name"/>
                <field name="student_id"/>
                <field name="document_type"/>
                <field name="file" filename="file_name"/>
                <field name="file_name" column_invisible="1"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="is_verified" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Student Document Form View -->
    <record id="view_student_document_form" model="ir.ui.view">
        <field name="name">algorid.student.document.form</field>
        <field name="model">algorid.student.document</field>
        <field name="arch" type="xml">
            <form string="Student Document">
                <header>
                    <button name="action_verify" string="Verify" type="object" class="btn-primary" invisible="is_verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="document_type"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_verified"/>
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Student Document Action -->
    <record id="action_student_document" model="ir.actions.act_window">
        <field name="name">Student Documents</field>
        <field name="res_model">algorid.student.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload student documents
            </p>
        </field>
    </record>
</odoo>

