<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student Tag Tree View -->
    <record id="view_student_tag_tree" model="ir.ui.view">
        <field name="name">algorid.student.tag.tree</field>
        <field name="model">algorid.student.tag</field>
        <field name="arch" type="xml">
            <list string="Student Tags" editable="bottom">
                <field name="name"/>
                <field name="name_bn"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Student Tag Form View -->
    <record id="view_student_tag_form" model="ir.ui.view">
        <field name="name">algorid.student.tag.form</field>
        <field name="model">algorid.student.tag</field>
        <field name="arch" type="xml">
            <form string="Student Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_bn"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Student Tag Action -->
    <record id="action_student_tag" model="ir.actions.act_window">
        <field name="name">Student Tags</field>
        <field name="res_model">algorid.student.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create student tags
            </p>
            <p>
                Tags help you categorize students (e.g., Scholarship, Special Needs).
            </p>
        </field>
    </record>
</odoo>

