<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_class_tree" model="ir.ui.view">
        <field name="name">algorid.class.tree</field>
        <field name="model">algorid.class</field>
        <field name="arch" type="xml">
            <list string="Classes" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>
    <record id="view_class_form" model="ir.ui.view">
        <field name="name">algorid.class.form</field>
        <field name="model">algorid.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Class Name"/></h1>
                        <field name="name_bn" placeholder="Class Name (Bangla)"/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="class_teacher_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sections" name="sections">
                            <field name="section_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="capacity"/>
                                    <field name="class_teacher_id"/>
                                    <field name="room_no"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subjects" name="subjects">
                            <field name="subject_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">algorid.class</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first class</p>
        </field>
    </record>
</odoo>
