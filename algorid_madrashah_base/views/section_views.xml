<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_section_tree" model="ir.ui.view">
        <field name="name">algorid.section.tree</field>
        <field name="model">algorid.section</field>
        <field name="arch" type="xml">
            <list string="Sections">
                <field name="name"/>
                <field name="class_id"/>
                <field name="capacity"/>
                <field name="student_count"/>
                <field name="class_teacher_id"/>
                <field name="room_no"/>
            </list>
        </field>
    </record>
    <record id="view_section_form" model="ir.ui.view">
        <field name="name">algorid.section.form</field>
        <field name="model">algorid.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_bn"/>
                            <field name="code"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="class_teacher_id"/>
                            <field name="room_no"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">algorid.section</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
