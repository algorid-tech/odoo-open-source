<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_year_tree" model="ir.ui.view">
        <field name="name">algorid.academic.year.tree</field>
        <field name="model">algorid.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years">
                <field name="name"/>
                <field name="code"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_current" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">algorid.academic.year.form</field>
        <field name="model">algorid.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_set_current" string="Set as Current" type="object" class="oe_stat_button" icon="fa-check" invisible="is_current"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Academic Year Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="is_current"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">algorid.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first academic year</p>
        </field>
    </record>
</odoo>
