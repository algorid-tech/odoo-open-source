<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Access Rules -->
    <record id="rule_student_portal_access" model="ir.rule">
        <field name="name">Student: Portal User Access</field>
        <field name="model_id" ref="algorid_madrashah_student.model_algorid_student"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_attendance_portal_access" model="ir.rule">
        <field name="name">Attendance: Portal User Access</field>
        <field name="model_id" ref="algorid_madrashah_attendance.model_algorid_student_attendance"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_fee_portal_access" model="ir.rule">
        <field name="name">Fee: Portal User Access</field>
        <field name="model_id" ref="algorid_madrashah_fees.model_algorid_student_fee"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_result_portal_access" model="ir.rule">
        <field name="name">Result: Portal User Access</field>
        <field name="model_id" ref="algorid_madrashah_exam.model_algorid_exam_result"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>

