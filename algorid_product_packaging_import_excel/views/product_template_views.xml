<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add smart button to product template form -->
    <record id="product_template_form_view_inherit_packaging_import" model="ir.ui.view">
        <field name="name">product.template.form.inherit.packaging.import</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_import_packaging_excel" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-file-excel-o"
                        groups="product.group_stock_packaging"
                        help="Import packaging from Excel file">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Import</span>
                        <span class="o_stat_text">Packaging</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
