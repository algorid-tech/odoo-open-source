<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Period Tree View -->
    <record id="view_period_tree" model="ir.ui.view">
        <field name="name">algorid.period.tree</field>
        <field name="model">algorid.period</field>
        <field name="arch" type="xml">
            <list string="Periods" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="name_bn"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration"/>
                <field name="period_type"/>
            </list>
        </field>
    </record>

    <!-- Period Form View -->
    <record id="view_period_form" model="ir.ui.view">
        <field name="name">algorid.period.form</field>
        <field name="model">algorid.period</field>
        <field name="arch" type="xml">
            <form string="Period">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_bn"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration"/>
                            <field name="period_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Period Action -->
    <record id="action_period" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">algorid.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure periods/time slots
            </p>
        </field>
    </record>
</odoo>

