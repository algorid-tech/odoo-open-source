<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Mirrors the standard binary field, wrapped in a drop area. -->
    <t t-name="algorid_binary_drop.BinaryDropField">
        <t t-if="!this.props.readonly">
            <div class="o_algorid_binary_drop_area w-100 p-2 text-center"
                 t-att-class="{ 'o_algorid_binary_drop_area_empty': !this.props.record.data[this.props.name] }"
                 t-ref="this.dropZoneRef">
                <t t-if="this.props.record.data[this.props.name]">
                    <div class="w-100 d-inline-flex gap-1">
                        <FileUploader
                            acceptedFileExtensions="this.props.acceptedFileExtensions"
                            allowedMIMETypes="this.props.allowedMIMETypes"
                            onUploaded.bind="this.update"
                        >
                            <t name="download" t-if="this.props.record.resId and !this.props.record.dirty">
                                <button
                                    class="oi btn btn-link o_download_file_button" data-icon="download"
                                    data-tooltip="Download"
                                    aria-label="Download"
                                    t-on-click.stop="this.onFileDownload"
                                />
                            </t>
                            <t t-set-slot="toggler">
                                <span t-if="!this.fileName" class="btn btn-primary o_select_file_button py-0">
                                    Replace current file
                                </span>
                                <t t-else="">
                                    <input type="text" class="o_input o_select_file_button" t-att-value="this.fileName" readonly="readonly"/>
                                </t>
                            </t>
                            <button
                                class="oi oi-filled btn btn-link o_clear_file_button" data-icon="delete"
                                data-tooltip="Clear"
                                aria-label="Clear"
                                t-on-click="() => this.update({})"
                            />
                        </FileUploader>
                    </div>
                    <small class="o_algorid_binary_drop_hint d-block text-muted mt-1" t-out="this.replaceHint"/>
                </t>
                <t t-else="">
                    <label class="o_select_file_button btn btn-primary">
                        <FileUploader
                            acceptedFileExtensions="this.props.acceptedFileExtensions"
                            allowedMIMETypes="this.props.allowedMIMETypes"
                            onUploaded.bind="this.update"
                        >
                            <t t-set-slot="toggler">
                                Upload your file
                            </t>
                        </FileUploader>
                    </label>
                    <small class="o_algorid_binary_drop_hint d-block text-muted mt-1" t-out="this.dropHint"/>
                </t>
            </div>
        </t>
        <t t-elif="this.props.record.resId and this.props.record.data[this.props.name]">
            <a class="o_form_uri" href="#" t-on-click.prevent.stop="this.onFileDownload">
                <span class="oi me-2" data-icon="download"/>
                <t t-if="this.fileName" t-out="this.fileName"/>
            </a>
        </t>
        <t t-elif="this.props.fileNameField" t-out="this.fileName"/>
    </t>

</templates>
