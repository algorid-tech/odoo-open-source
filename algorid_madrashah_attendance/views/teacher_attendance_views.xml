<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teacher Attendance Tree View -->
    <record id="view_teacher_attendance_tree" model="ir.ui.view">
        <field name="name">algorid.teacher.attendance.tree</field>
        <field name="model">algorid.teacher.attendance</field>
        <field name="arch" type="xml">
            <list string="Teacher Attendance" editable="bottom">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="status" widget="badge" decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'late'" decoration-info="status in ('on_leave', 'half_day')"/>
                <field name="check_in_time" widget="float_time"/>
                <field name="check_out_time" widget="float_time"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Teacher Attendance Form View -->
    <record id="view_teacher_attendance_form" model="ir.ui.view">
        <field name="name">algorid.teacher.attendance.form</field>
        <field name="model">algorid.teacher.attendance</field>
        <field name="arch" type="xml">
            <form string="Teacher Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="status" widget="radio"/>
                        </group>
                        <group>
                            <field name="check_in_time" widget="float_time"/>
                            <field name="check_out_time" widget="float_time"/>
                            <field name="worked_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Teacher Attendance Search View -->
    <record id="view_teacher_attendance_search" model="ir.ui.view">
        <field name="name">algorid.teacher.attendance.search</field>
        <field name="model">algorid.teacher.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Teacher Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Present" name="present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="absent" domain="[('status', '=', 'absent')]"/>
                <filter string="On Leave" name="on_leave" domain="[('status', '=', 'on_leave')]"/>
            </search>
        </field>
    </record>

    <!-- Teacher Attendance Action -->
    <record id="action_teacher_attendance" model="ir.actions.act_window">
        <field name="name">Teacher Attendance</field>
        <field name="res_model">algorid.teacher.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_teacher_attendance_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record teacher attendance
            </p>
        </field>
    </record>
</odoo>

