<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teacher Schedule Tree View -->
    <record id="view_teacher_schedule_tree" model="ir.ui.view">
        <field name="name">algorid.teacher.schedule.tree</field>
        <field name="model">algorid.teacher.schedule</field>
        <field name="arch" type="xml">
            <list string="Teacher Schedules" editable="bottom">
                <field name="teacher_id"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="room_no"/>
            </list>
        </field>
    </record>

    <!-- Teacher Schedule Form View -->
    <record id="view_teacher_schedule_form" model="ir.ui.view">
        <field name="name">algorid.teacher.schedule.form</field>
        <field name="model">algorid.teacher.schedule</field>
        <field name="arch" type="xml">
            <form string="Teacher Schedule">
                <sheet>
                    <group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="day_of_week"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                            <field name="section_id"/>
                            <field name="subject_id"/>
                            <field name="room_no"/>
                            <field name="academic_year_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Teacher Schedule Search View -->
    <record id="view_teacher_schedule_search" model="ir.ui.view">
        <field name="name">algorid.teacher.schedule.search</field>
        <field name="model">algorid.teacher.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Schedules">
                <field name="teacher_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="day_of_week"/>
            </search>
        </field>
    </record>

    <!-- Teacher Schedule Action -->
    <record id="action_teacher_schedule" model="ir.actions.act_window">
        <field name="name">Teacher Schedules</field>
        <field name="res_model">algorid.teacher.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_teacher_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create teacher schedules
            </p>
            <p>
                Define weekly schedules for teachers with class and subject assignments.
            </p>
        </field>
    </record>
</odoo>
